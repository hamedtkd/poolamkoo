# BrsApi: primary server-side source for gold, currency, and crypto.
# Poolamkoo shares a short 60-second server cache across requests to protect provider quota.
BRS_API_KEY=

# Tehran Stock Exchange stocks/ETFs use cdn.tsetmc.com directly through Poolamkoo's
# server routes. TSETMC does not require an API key; no environment variable is needed.
#
# Tindex is OPTIONAL in v0.32. It is kept only for:
# - legacy assets/watchlist items linked by older Poolamkoo releases
# - a slow emergency fallback when BrsApi misses core USD/gold/BTC quotes
# - optional online USD/gold history
# The free Tindex tier is extremely limited, so new exchange links do not depend on it.
TINDEX_API_TOKEN=

# Background Web Push is intentionally paused in the public zero-cost roadmap.
# Normal deployments do not need Redis, VAPID keys, a cron service, or this flag.
# The preserved experiment can be reviewed in docs/backlog/background-push.md.
# NEXT_PUBLIC_EXPERIMENTAL_BACKGROUND_PUSH=0

# Optional Cloudflare Web Analytics site token. This token is public by design because
# it is embedded in the browser beacon. Leave empty to ship with zero analytics.
# Poolamkoo loads the beacon only in production and never sends custom financial events.
NEXT_PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN=

# Optional canonical public URL used by metadata, robots.txt and sitemap.xml.
# The default is https://poolamkoo.vercel.app. Set this when moving to a custom domain.
NEXT_PUBLIC_SITE_URL=https://poolamkoo.vercel.app
