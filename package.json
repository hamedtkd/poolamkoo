{
  "name": "poolamkoo",
  "version": "0.38.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "check:lines": "node scripts/check-file-lines.mjs",
    "check": "npm run clean:obsolete && npm run check:icons && npm run check:animations && npm run typecheck && npm run lint && npm test && npm run check:lines && npm run check:ui && npm run check:performance && npm run check:regressions",
    "check:ui": "node scripts/check-ui-architecture.mjs",
    "check:regressions": "node scripts/check-regressions.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "clean:obsolete": "node scripts/remove-obsolete-routes.mjs",
    "predev": "npm run clean:obsolete",
    "prebuild": "npm run clean:obsolete",
    "push:keys": "web-push generate-vapid-keys",
    "check:performance": "node scripts/check-performance.mjs",
    "media:capture": "npm run build && node scripts/capture-product-media.mjs",
    "media:capture:built": "node scripts/capture-product-media.mjs",
    "check:icons": "node scripts/check-icon-imports.mjs",
    "test:browser:release": "npm run build && node scripts/release-browser-smoke.mjs",
    "test:browser:release:built": "node scripts/release-browser-smoke.mjs",
    "check:release": "npm run check && npm run build && npm run test:browser:release:built",
    "check:animations": "node scripts/check-animation-dependencies.mjs"
  },
  "dependencies": {
    "@tanstack/react-table": "9.1.2",
    "dexie": "4.4.5",
    "dexie-react-hooks": "4.4.0",
    "lightweight-charts": "5.2.1",
    "motion": "^12.0.0",
    "next": "16.3.2",
    "next-themes": "0.4.6",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "5.7.0",
    "recharts": "3.10.1",
    "react-hook-form": "^7.62.0",
    "@hookform/resolvers": "^5.2.1",
    "zod": "^4.1.5",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.0",
    "tailwindcss-animated": "2.1.0"
  }
}
